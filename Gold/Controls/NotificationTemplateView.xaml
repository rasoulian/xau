<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Gold.Controls.NotificationTemplateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <StackLayout Padding="5,20">
        <Border
            Padding="10"
            HorizontalOptions="Center"
            Stroke="#fbad30"
            StrokeShape="RoundRectangle 5"
            StrokeThickness="2">
            <VerticalStackLayout Spacing="10" WidthRequest="310">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontFamily="IRANSansMedium"
                    Text="{Binding MessageBody}"
                    TextColor="Black" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    FlowDirection="LeftToRight"
                    FontFamily="IRANSansUltraLight"
                    FontSize="Caption"
                    Text="{Binding At}" />
            </VerticalStackLayout>
        </Border>

    </StackLayout>

</ContentView>
